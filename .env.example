####################################################################
# test-rca-app — example configuration
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored and must NEVER be committed.
# Every value below is a placeholder. No real credentials here.
####################################################################

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_NAME=test-rca-app
APP_ENV=test
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Port the app listens on. Inside the container this is fixed at 8080;
# use APP_PORT to change the host-side port published by docker compose.
PORT=8080
APP_PORT=8080

# ------------------------------------------------------------------
# Database (REQUIRED)
#
# Either set DATABASE_URL, or set all five DATABASE_* values below.
# DATABASE_URL wins if both are present.
#
# Managed PostgreSQL (Render, RDS with TLS enforced, etc.) usually needs
# SSL — append ?sslmode=require to the URL.
# ------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@hostname:5432/database
# DATABASE_URL=postgresql://username:password@hostname:5432/database?sslmode=require

# Alternative to DATABASE_URL (leave DATABASE_URL empty/unset to use these):
# DATABASE_HOST=hostname
# DATABASE_PORT=5432
# DATABASE_NAME=database
# DATABASE_USER=username
# DATABASE_PASSWORD=password

# Connection pool and timeouts
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=60000

# Create tables if missing, and insert a small seed dataset (idempotent).
DB_AUTO_INIT=true
DB_SEED=true
DB_SEED_USERS=25

# ------------------------------------------------------------------
# Health check
#
# false (default): /health reports healthy even when the database is down,
# so a database outage shows as failing API endpoints instead of a dead
# container. Set true only if you want the DB in the liveness path.
# ------------------------------------------------------------------
HEALTH_CHECK_DB=false

# ------------------------------------------------------------------
# Failure scenario bounds (safety limits)
# ------------------------------------------------------------------
# Scenario 2 — CPU stress: hard cap on ?duration=
CPU_STRESS_MAX_DURATION=120

# Scenario 4 — database latency: hard cap and default for ?seconds=
SLOW_QUERY_MAX_SECONDS=30
SLOW_QUERY_DEFAULT_SECONDS=5

# ------------------------------------------------------------------
# Scenario 1 — database failure simulation
#
# Application-level only: it raises synthetic connection errors and never
# touches the real database.
#   SIMULATE_DB_FAILURE=true starts the app with the simulation already armed.
#   DB_FAILURE_MODE: connection_refused | connection_timeout | query_error
#   ENABLE_TEST_CONTROLS enables POST /api/test/db-failure for runtime toggling.
# ------------------------------------------------------------------
SIMULATE_DB_FAILURE=false
DB_FAILURE_MODE=connection_refused
DB_FAILURE_DELAY_SECONDS=2
ENABLE_TEST_CONTROLS=true

# ------------------------------------------------------------------
# Baseline traffic generator
#
# Calls the app's own read endpoints so Prometheus and Loki always have a
# normal baseline to compare an incident against. Never triggers the
# failure scenarios.
# ------------------------------------------------------------------
TRAFFIC_GENERATOR_ENABLED=true
TRAFFIC_GENERATOR_RPS=2
TRAFFIC_GENERATOR_BASE_URL=http://127.0.0.1:8080
