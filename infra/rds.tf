# ---------------------------------------------------------------------------
# RDS PostgreSQL — managed database for the test-rca-app stack.
#
# Lifecycle:  `terraform apply` creates it, `terraform destroy` removes it.
# skip_final_snapshot = true is intentional: this is an ephemeral test env
# where a final snapshot would block `destroy` and incur unnecessary cost.
#
# The master password is generated by the `random_password` resource so it
# never appears in tfvars or user data. It is stored in the Terraform state
# (keep the state file encrypted / on a secure backend) and in an SSM
# SecureString that the EC2 instance reads at boot.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Random master password — regenerated only when the RDS instance is replaced.
# ---------------------------------------------------------------------------
resource "random_password" "rds" {
  length           = 20
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?" # excludes @, /, \ which break psycopg URLs
  min_lower        = 2
  min_upper        = 2
  min_numeric      = 2
  min_special      = 1
}

# ---------------------------------------------------------------------------
# Subnet group — spans both public subnets (RDS requires >= 2 AZs).
# ---------------------------------------------------------------------------
resource "aws_db_subnet_group" "this" {
  name        = "${local.name_prefix}-rds-subnet-group"
  description = "Subnet group for ${local.name_prefix} RDS instance"
  subnet_ids  = aws_subnet.public[*].id

  tags = { Name = "${local.name_prefix}-rds-subnet-group" }
}

# ---------------------------------------------------------------------------
# RDS security group
# ---------------------------------------------------------------------------
resource "aws_security_group" "rds" {
  name        = "${local.name_prefix}-rds-sg"
  description = "PostgreSQL access for ${local.name_prefix} (app SG only)"
  vpc_id      = aws_vpc.this.id

  tags = { Name = "${local.name_prefix}-rds-sg" }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_vpc_security_group_ingress_rule" "rds_from_app" {
  security_group_id            = aws_security_group.rds.id
  description                  = "PostgreSQL from the app instance SG"
  referenced_security_group_id = aws_security_group.app.id
  from_port                    = 5432
  to_port                      = 5432
  ip_protocol                  = "tcp"
}

resource "aws_vpc_security_group_egress_rule" "rds_all" {
  security_group_id = aws_security_group.rds.id
  description       = "Allow all outbound (required for RDS maintenance)"
  cidr_ipv4         = "0.0.0.0/0"
  ip_protocol       = "-1"
}

# ---------------------------------------------------------------------------
# RDS instance
# ---------------------------------------------------------------------------
resource "aws_db_instance" "postgres" {
  identifier = "${local.name_prefix}-postgres"

  engine         = "postgres"
  engine_version = var.rds_engine_version
  instance_class = var.rds_instance_class

  allocated_storage     = var.rds_allocated_storage
  max_allocated_storage = var.rds_allocated_storage * 2 # autoscaling up to 2x
  storage_type          = "gp2"
  storage_encrypted     = true

  db_name  = var.rds_db_name
  username = var.rds_username
  password = random_password.rds.result

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = true # accessible from VPC and publicly (test env)

  # Backups disabled for ephemeral test env to reduce cost and speed up destroy.
  backup_retention_period = 0
  skip_final_snapshot     = true
  deletion_protection     = false

  # Performance Insights and enhanced monitoring add cost; disable for test.
  performance_insights_enabled = false
  monitoring_interval          = 0

  # Allow minor version upgrades automatically; major version is pinned.
  auto_minor_version_upgrade = true
  apply_immediately          = true

  tags = { Name = "${local.name_prefix}-postgres" }

  depends_on = [
    aws_db_subnet_group.this,
    aws_security_group.rds,
  ]
}
